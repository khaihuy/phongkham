generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PHARMACIST
  ACCOUNTANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  GENERAL
  SPECIALIST
  FOLLOW_UP
  EMERGENCY
  TELEMEDICINE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOMO
  ZALOPAY
  VNPAY
  INSURANCE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum DrugUnit {
  TABLET
  CAPSULE
  BOTTLE
  AMPOULE
  TUBE
  SACHET
  VIAL
  BOX
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  PARTIAL
  CANCELLED
}

enum ProductType {
  DRUG          // Thuốc (cần kê đơn, có quản lý theo Luật Dược)
  SUPPLEMENT    // Thực phẩm bổ sung / TPCN (không kê đơn, quản lý nhẹ hơn)
}

enum PrescriptionType {
  PRESCRIPTION       // Đơn thuốc
  SUPPLEMENT_ORDER   // Đơn thực phẩm bổ sung
}

enum DrugTransactionType {
  IMPORT
  EXPORT
  ADJUSTMENT
  RETURN
  EXPIRED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationChannel {
  SMS
  ZALO
  EMAIL
  IN_APP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum TelemedicineStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  MISSED
}

// ─────────────────────────────────────────
// MODULE: CLINIC CONFIG
// ─────────────────────────────────────────

model Clinic {
  id          String   @id @default(cuid())
  name        String
  taxCode     String?
  phone       String
  email       String?
  address     String
  logoUrl     String?
  website     String?
  licenseNo   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches    Branch[]
  services    Service[]
}

model Branch {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  address   String
  phone     String
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic      Clinic        @relation(fields: [clinicId], references: [id])
  rooms       Room[]
  doctors     Doctor[]
  appointments Appointment[]
}

model Room {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  code      String
  floor     Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch       Branch        @relation(fields: [branchId], references: [id])
  appointments Appointment[]
}

// ─────────────────────────────────────────
// MODULE: AUTH & USER MANAGEMENT
// ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  fullName      String
  phone         String?
  avatarUrl     String?
  role          Role
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  doctor        Doctor?
  auditLogs     AuditLog[]
  createdInvoices Invoice[] @relation("InvoiceCreatedBy")
  performedMedicalServices MedicalRecordService[] @relation("PerformedMedicalServices")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────
// MODULE: DOCTOR
// ─────────────────────────────────────────

model Doctor {
  id             String   @id @default(cuid())
  userId         String   @unique
  branchId       String
  employeeCode   String   @unique
  specialtyId    String
  title          String?
  bio            String?
  licenseNo      String
  yearsOfExp     Int      @default(0)
  consultFee     Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  user           User           @relation(fields: [userId], references: [id])
  branch         Branch         @relation(fields: [branchId], references: [id])
  specialty      Specialty      @relation(fields: [specialtyId], references: [id])
  schedules      DoctorSchedule[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
}

model Specialty {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  doctors Doctor[]
}

model DoctorSchedule {
  id          String    @id @default(cuid())
  doctorId    String
  dayOfWeek   DayOfWeek
  startTime   String
  endTime     String
  slotMinutes Int       @default(30)
  maxSlots    Int       @default(10)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, dayOfWeek, startTime])
}

model DoctorLeave {
  id        String   @id @default(cuid())
  doctorId  String
  startDate DateTime
  endDate   DateTime
  reason    String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
// MODULE: PATIENT (EMR)
// ─────────────────────────────────────────

model Patient {
  id             String    @id @default(cuid())
  patientCode    String    @unique
  fullName       String
  dateOfBirth    DateTime
  gender         Gender
  phone          String
  email          String?
  address        String?
  ward           String?
  district       String?
  province       String?
  idCardNo       String?
  insuranceNo    String?
  bloodType      BloodType @default(UNKNOWN)
  occupation     String?
  emergencyName  String?
  emergencyPhone String?
  emergencyRel   String?
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  allergies      Allergy[]
  vitals         PatientVital[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  invoices       Invoice[]
}

model Allergy {
  id          String   @id @default(cuid())
  patientId   String
  allergen    String
  reaction    String?
  severity    String?
  notes       String?
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model PatientVital {
  id          String   @id @default(cuid())
  patientId   String
  recordedAt  DateTime @default(now())
  weight      Decimal? @db.Decimal(5, 2)
  height      Decimal? @db.Decimal(5, 2)
  bmi         Decimal? @db.Decimal(5, 2)
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate   Int?
  temperature Decimal? @db.Decimal(4, 1)
  oxygenSat   Int?
  notes       String?

  patient Patient @relation(fields: [patientId], references: [id])
}

// ─────────────────────────────────────────
// MODULE: APPOINTMENT
// ─────────────────────────────────────────

model Appointment {
  id              String            @id @default(cuid())
  appointmentCode String            @unique
  patientId       String
  doctorId        String
  branchId        String
  roomId          String?
  specialtyId     String?
  type            AppointmentType   @default(GENERAL)
  status          AppointmentStatus @default(PENDING)
  scheduledDate   DateTime
  scheduledTime   String
  queueNumber     Int?
  duration        Int               @default(30)
  chiefComplaint  String?
  notes           String?
  serviceId       String?
  cancelReason    String?
  vitalSigns      Json?
  reminderSent    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  patient        Patient        @relation(fields: [patientId], references: [id])
  doctor         Doctor         @relation(fields: [doctorId], references: [id])
  branch         Branch         @relation(fields: [branchId], references: [id])
  room           Room?          @relation(fields: [roomId], references: [id])
  medicalRecord  MedicalRecord?
  invoice        Invoice?
  telemedicine   Telemedicine?
  service        Service?       @relation("AppointmentService", fields: [serviceId], references: [id])
}

// ─────────────────────────────────────────
// MODULE: MEDICAL RECORDS (EMR)
// ─────────────────────────────────────────

model MedicalRecord {
  id              String   @id @default(cuid())
  recordCode      String   @unique
  appointmentId   String?  @unique
  patientId       String
  doctorId        String
  visitDate       DateTime
  chiefComplaint  String?
  clinicalNotes   String?
  physicalExam    String?
  diagnosis       String?
  icdCode         String?
  treatment       String?
  followUpDate    DateTime?
  followUpNotes   String?
  isConfidential  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointment    Appointment?   @relation(fields: [appointmentId], references: [id])
  patient        Patient        @relation(fields: [patientId], references: [id])
  doctor         Doctor         @relation(fields: [doctorId], references: [id])
  diagnoses      Diagnosis[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  imageOrders    ImageOrder[]
  services       MedicalRecordService[]
  invoice        Invoice?
}

enum MedicalServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model MedicalRecordService {
  id              String                @id @default(cuid())
  medicalRecordId String
  serviceId       String
  sequence        Int                   // thứ tự thực hiện trong hồ sơ (1, 2, 3...)
  status          MedicalServiceStatus  @default(PENDING)
  notes           String?
  performedAt     DateTime?
  performedById   String?
  quantity        Int                   @default(1)
  unitPrice       Decimal               @db.Decimal(12, 2)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  service       Service       @relation(fields: [serviceId], references: [id])
  performer     User?         @relation("PerformedMedicalServices", fields: [performedById], references: [id])

  @@unique([medicalRecordId, sequence])
  @@index([medicalRecordId])
}

model Diagnosis {
  id              String   @id @default(cuid())
  medicalRecordId String
  icdCode         String?
  description     String
  isPrimary       Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id])
}

model LabOrder {
  id              String   @id @default(cuid())
  medicalRecordId String
  testName        String
  testCode        String?
  instructions    String?
  result          String?
  resultDate      DateTime?
  status          String   @default("PENDING")
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  serviceId       String?

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  service       Service?      @relation(fields: [serviceId], references: [id])
}

model ImageOrder {
  id              String   @id @default(cuid())
  medicalRecordId String
  imagingType     String
  bodyPart        String?
  instructions    String?
  findings        String?
  imageUrl        String?
  status          String   @default("PENDING")
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  serviceId       String?

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  service       Service?      @relation(fields: [serviceId], references: [id])
}

// ─────────────────────────────────────────
// MODULE: PHARMACY
// ─────────────────────────────────────────

model DrugCategory {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  parent   DrugCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children DrugCategory[] @relation("CategoryTree")
  drugs    Drug[]
}

model Drug {
  id              String   @id @default(cuid())
  categoryId      String
  productType     ProductType @default(DRUG)
  name            String
  genericName     String?
  brandName       String?
  code            String   @unique
  barcode         String?  @unique
  unit            DrugUnit
  strength        String?
  form            String?
  manufacturer    String?
  countryOfOrigin String?
  registrationNo  String?
  requirePrescription Boolean @default(false)
  minStock        Int      @default(10)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category          DrugCategory        @relation(fields: [categoryId], references: [id])
  inventory         DrugInventory[]
  prescriptionItems PrescriptionItem[]
  invoiceItems      InvoiceItem[]
}

model DrugInventory {
  id              String   @id @default(cuid())
  drugId          String
  batchNo         String
  expiryDate      DateTime
  quantity        Int
  importPrice     Decimal  @db.Decimal(12, 2)
  sellPrice       Decimal  @db.Decimal(12, 2)
  supplierId      String?
  importDate      DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  drug         Drug             @relation(fields: [drugId], references: [id])
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  transactions DrugTransaction[]

  @@unique([drugId, batchNo])
}

model DrugTransaction {
  id          String              @id @default(cuid())
  inventoryId String
  type        DrugTransactionType
  quantity    Int
  unitPrice   Decimal             @db.Decimal(12, 2)
  totalAmount Decimal             @db.Decimal(12, 2)
  reference   String?
  notes       String?
  createdAt   DateTime            @default(now())

  inventory DrugInventory @relation(fields: [inventoryId], references: [id])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  taxCode   String?
  phone     String
  email     String?
  address   String?
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory DrugInventory[]
}

model Prescription {
  id              String             @id @default(cuid())
  medicalRecordId String
  prescriptionCode String            @unique
  type            PrescriptionType   @default(PRESCRIPTION)
  status          PrescriptionStatus @default(PENDING)
  notes           String?
  dispensedAt     DateTime?
  dispensedBy     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  medicalRecord MedicalRecord      @relation(fields: [medicalRecordId], references: [id])
  items         PrescriptionItem[]
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  drugId         String
  quantity       Int
  dosage         String
  frequency      String
  duration       String
  route          String?
  instructions   String?
  unitPrice      Decimal @db.Decimal(12, 2)

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  drug         Drug         @relation(fields: [drugId], references: [id])
}

// ─────────────────────────────────────────
// MODULE: BILLING
// ─────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  code        String   @unique
  categoryId  String?
  price       Decimal  @db.Decimal(12, 2)
  unit        String   @default("lần")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  invoiceItems InvoiceItem[]
  labOrders    LabOrder[]
  imageOrders  ImageOrder[]
  appointments Appointment[] @relation("AppointmentService")
  medicalRecordServices MedicalRecordService[]
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceCode     String        @unique
  patientId       String
  appointmentId   String?       @unique
  medicalRecordId String?       @unique
  createdById     String
  status          InvoiceStatus @default(DRAFT)
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2) @default(0)
  discountType    String?
  taxAmount       Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal       @db.Decimal(12, 2)
  insuranceCover  Decimal       @db.Decimal(12, 2) @default(0)
  patientPays     Decimal       @db.Decimal(12, 2)
  notes           String?
  dueDate         DateTime?
  issuedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  patient     Patient       @relation(fields: [patientId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  createdBy     User           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items         InvoiceItem[]
  payments    Payment[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  type        String
  serviceId   String?
  drugId      String?
  name        String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @db.Decimal(12, 2) @default(0)
  totalPrice  Decimal  @db.Decimal(12, 2)
  notes       String?

  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  drug    Drug?    @relation(fields: [drugId], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PAID)
  transactionId String?
  reference     String?
  paidAt        DateTime      @default(now())
  notes         String?
  createdAt     DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

// ─────────────────────────────────────────
// MODULE: MARKETING
// ─────────────────────────────────────────

model Campaign {
  id          String         @id @default(cuid())
  name        String
  type        String
  channel     NotificationChannel
  status      CampaignStatus @default(DRAFT)
  targetGroup String?
  message     String
  scheduledAt DateTime?
  sentAt      DateTime?
  totalSent   Int            @default(0)
  totalFailed Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  logs CampaignLog[]
}

model CampaignLog {
  id          String   @id @default(cuid())
  campaignId  String
  patientId   String?
  channel     NotificationChannel
  recipient   String
  message     String
  status      String
  sentAt      DateTime?
  errorMsg    String?
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model AppointmentReminder {
  id            String   @id @default(cuid())
  appointmentId String
  channel       NotificationChannel
  scheduledAt   DateTime
  sentAt        DateTime?
  status        String   @default("PENDING")
  message       String
  createdAt     DateTime @default(now())
}

// ─────────────────────────────────────────
// MODULE: TELEMEDICINE
// ─────────────────────────────────────────

model Telemedicine {
  id            String             @id @default(cuid())
  appointmentId String             @unique
  status        TelemedicineStatus @default(SCHEDULED)
  roomCode      String             @unique
  startedAt     DateTime?
  endedAt       DateTime?
  duration      Int?
  recordingUrl  String?
  patientJoined Boolean            @default(false)
  doctorJoined  Boolean            @default(false)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}
